<Project>
    <PropertyGroup>
        <!-- Local dev default. CI overrides via -p:Version= which cascades to all version properties -->
        <Version>0.0.0.1</Version>
        <!-- Advisories in Jellyfin's transitive (compile-only) graph aren't fixable here; keep them visible but non-fatal -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    </PropertyGroup>
</Project>
